{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "asan",
      "displayName": "Debug with host sanitizers",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "ROSA_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "ubsan",
      "displayName": "Debug with UndefinedBehaviorSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/ubsan",
      "cacheVariables": {
        "ROSA_SANITIZERS": "undefined"
      }
    },
    {
      "name": "baseline",
      "displayName": "Debug without LLVM or Rosetta",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/baseline",
      "cacheVariables": {
        "ROSA_ENABLE_LLVM_JIT": "OFF",
        "ROSA_ENABLE_ROSETTA_DIFFERENTIAL_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "baseline",
      "configurePreset": "baseline"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "baseline",
      "configurePreset": "baseline",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
